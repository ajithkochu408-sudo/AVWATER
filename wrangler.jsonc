{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avwater",
  "main": "worker.js",
  "compatibility_date": "2026-06-10",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "keep_vars": true
}
